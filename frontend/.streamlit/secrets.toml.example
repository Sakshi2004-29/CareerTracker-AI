# Copy to "secrets.toml" (same folder) for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# These two values are NOT AI/database secrets: they only say where the backend is.

BACKEND_URL = "http://localhost:8000"
# Must match BACKEND_API_KEY in the backend's environment (leave "" if the backend has none).
BACKEND_API_KEY = ""
