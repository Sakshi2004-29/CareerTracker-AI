# ---------------------------------------------------------------
# CareerTrack AI - backend configuration
# Copy this file to ".env" (same folder) and edit the copy.
# NEVER commit the real .env file. It is listed in .gitignore.
# ---------------------------------------------------------------

# "development" locally, "production" on Render.
ENVIRONMENT=development

# DEMO_MODE=true  -> uses a local SQLite file (backend/demo.db) and
#                    works with NO Supabase and NO Gemini key.
#                    AI answers are simple built-in templates unless
#                    you also set GEMINI_API_KEY.
# DEMO_MODE=false -> uses your real Supabase database (set the 2 keys below).
DEMO_MODE=true

# --- Supabase (needed when DEMO_MODE=false) ---
# Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# The SECRET / service_role key (Project Settings -> API Keys). Server-side only!
SUPABASE_SERVICE_KEY=

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name is configurable because Google retires models over time.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Security ---
# Optional locally, REQUIRED in production. If set, every /api request must
# send the header "X-API-Key: <this value>". The Streamlit app sends it for you
# (set the same value as BACKEND_API_KEY in the frontend).
# Generate one in PowerShell:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
BACKEND_API_KEY=

# The URL of your deployed Streamlit app (no trailing slash). In production CORS
# allows ONLY this origin. Example: https://careertrack-ai.streamlit.app
FRONTEND_ORIGIN=

# Used to decide what "today" means for follow-up reminders.
# Examples: UTC, Asia/Kolkata, America/New_York
APP_TIMEZONE=UTC

# Allow POST /api/demo/seed (the "Load demo data" button). Keep false in production.
ALLOW_DEMO_SEED=true
